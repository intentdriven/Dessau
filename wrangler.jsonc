{
  // The landing page's Worker: static assets only, no script. The assets are
  // the output of `make site` (cmd/dessau-site), which writes them under a
  // Dessau/ subdirectory so the served path matches the first route below,
  // and writes `_headers` and `_redirects` at the root of that directory,
  // which is where the host reads them.
  //
  // GITHUB ACTIONS IS THE ONLY DEPLOYER. The Worker's automatic build on push
  // is disconnected on purpose — a dashboard setting, recorded here because the
  // tree is the only durable record of it:
  //   automatic production builds:  disabled
  //   automatic branch builds:      disabled
  // What deploys instead is .github/workflows/site.yml, called by the release
  // chain once a release has published: a render job that holds no credential
  // hands its output to a deploy job that holds the Cloudflare token and runs
  // no build code. Reconnecting the dashboard build would put a second,
  // unreviewed path onto this address.
  //
  // Two GitHub Environments gate that workflow, and this is the only durable
  // record of how they are configured:
  //   site-render   the render job. NO SECRETS. Deployment policy: branch
  //                 `main` AND tags `v*`.
  //   site          the deploy job. Same policy. Holds CLOUDFLARE_API_TOKEN and
  //                 CLOUDFLARE_ACCOUNT_ID, read by exactly one step.
  // The {main, v*} policy refuses unreviewed workflow content: a dispatch runs
  // the workflow file as it exists on the ref it was dispatched from, so an
  // arbitrary branch is refused, while `main` is the reviewed state and a `v*`
  // tag is immutable. Residual, plainly: whoever can merge to main can change
  // the workflow and have it run with these secrets — this repository's
  // ordinary review boundary, not a new one.
  // The Worker's own name is a dashboard identifier nobody reads, and it is
  // deliberately NOT the family name: a Worker is addressed by name, so a new
  // name is a new Worker, and the old one would go on holding the superseded
  // route while the new one's deploy is refused the same pattern — a failed
  // site deploy inside every release until someone deletes the old Worker by
  // hand. Keeping the name makes the deploy an update in place: this one
  // Worker holds both routes and nothing races it. Renaming it is a dashboard
  // act, taken with this line, whenever the maintainer chooses.
  "name": "gropius",
  "compatibility_date": "2026-09-06",
  // PATH ROUTES, not a custom domain: the apex is the organization's own site
  // and only these two paths belong to this project. The deploy asserts the
  // routes, so a drifted attachment is reclaimed on the next release rather
  // than left wherever the dashboard last put it.
  //
  // The second route is what lets the redirect answer. A superseded path that
  // no Worker is attached to is not a 301, it is the apex's own 404: the
  // _redirects file in the assets root can only rewrite a request this Worker
  // is already handed. So the old path is routed here in order to be sent
  // away again. Both routes belong to this one Worker (see its name above),
  // so nothing else on the zone claims either path.
  "routes": [
    { "pattern": "intentdriven.sh/Dessau*", "zone_name": "intentdriven.sh" },
    { "pattern": "intentdriven.sh/Gropius*", "zone_name": "intentdriven.sh" }
  ],
  "assets": {
    "directory": "./site",
    // The page lives at site/Dessau/index.html, so a request for /Dessau and
    // one for /Dessau/ must both reach it; auto-trailing-slash is what serves
    // the directory index for either spelling.
    "html_handling": "auto-trailing-slash",
    // The documented default. Nothing renders a 404 page today, and claiming
    // "404-page" without one would fall back to a plain 404 anyway; when the
    // site grows one, this is the line that changes.
    "not_found_handling": "none"
  }
}
